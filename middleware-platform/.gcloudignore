# Cloud Build upload — without this, `gcloud builds submit` uploads the whole tree (~GB).
# See: https://cloud.google.com/sdk/gcloud/reference/topic/gcloudignore

.gcloudignore
.git
.gitignore

node_modules/
npm-debug.log*
*.log
.env
.env.*
*.db
backups/
coverage/
cypress/
e2e/
__tests__/
test-results/
uploads/
data/
.DS_Store
*.md
!package.json
