# Somo Trading Agent — environment template

NODE_ENV=development
PORT=4000

TRADING_MODE=paper
# TRADING_AGENT_ENABLED=1

# LLM
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Pinecone
# VECTOR_SEARCH_BACKEND=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=
# PINECONE_NAMESPACE=biotech-news
# EMBEDDING_PROVIDER=openai

# LangSmith
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=somo-trading-dev

# LangGraph checkpointer (optional)
# POSTGRES_URL=
# LANGGRAPH_USE_POSTGRES=true

# SQLite
# TRADING_DB_PATH=./data/trading.sqlite

# Telegram paper wallet (money commands require allowlisted user ids)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=123456789
# TELEGRAM_ALLOWED_CHAT_IDS=
# PAPER_WALLET_ID=default
# PAPER_FUND_MAX_PER_CMD=50000
# PAPER_WITHDRAW_MAX_PER_CMD=50000
# PAPER_FUND_MAX_PER_DAY=100000
# PAPER_WITHDRAW_MAX_PER_DAY=100000
# PAPER_WALLET_MAX_CMDS_PER_HOUR=20
# PAPER_WALLET_CONFIRM_TTL_SEC=60

# Alpaca paper (not wired yet — AlpacaBroker throws NOT_WIRED; never call from LLM tools)
# APCA_API_KEY=
# APCA_SECRET_KEY=
# APCA_BASE_URL=https://paper-api.alpaca.markets
# BROKER_DRIVER=paper

# Policy / risk
# KILL_SWITCH=0
# POLICY_CONFIRM_NOTIONAL=25000
# RISK_MIN_PRICE=1
# RISK_MAX_NOTIONAL=50000
# RISK_MAX_POSITION_PCT=0.25
# RISK_MAX_EXPOSURE=100000
# RISK_MIN_ADV=100000

# Market data — never set EXECUTION_PATH=1 with Yahoo provider
# EXECUTION_PATH=0
